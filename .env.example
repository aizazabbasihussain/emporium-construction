# Names only. Copy to .env and fill in locally. Never commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL (Supabase session pooler in the cloud, local Postgres in Pakistan hosting)
DATABASE_URL=

# Auth verification: set the JWKS URL, or the legacy JWT secret
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=

# File store driver: supabase | local
FILE_STORE_DRIVER=supabase
# local driver (see apps/api/src/modules/files/README.md)
FILE_STORE_LOCAL_DIR=
FILE_URL_SECRET=
PUBLIC_API_URL=
# supabase driver (server only, never expose to the browser)
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=

# Government project data is allowed only in the Pakistan-hosted production environment
ALLOW_GOVERNMENT_DATA=false

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
