{
  "name": "emporium-construction",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run --coverage",
    "test:tools": "vitest run --config tools/vitest.config.ts",
    "boundaries": "depcruise apps packages --config .dependency-cruiser.cjs",
    "spec:check": "node specs/tools/spec-index.mjs",
    "spec:status": "node specs/tools/spec-index.mjs --write",
    "build": "pnpm -r build",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:tools && pnpm boundaries && pnpm spec:check && pnpm docs:check && pnpm build",
    "module:new": "node tools/module-new.mjs",
    "docs:check": "node tools/docs-check/run.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,cjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html,sql}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.x",
      "onFail": "download"
    }
  }
}
